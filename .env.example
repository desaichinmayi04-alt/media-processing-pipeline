# Copy to .env for local overrides. All have sensible defaults in app/config.py.

# Local dev default: SQLite file, zero setup.
# For docker-compose / production, use Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://pipeline:pipeline@localhost:5432/media_pipeline
DATABASE_URL=sqlite:///./storage/app.db

REDIS_URL=redis://localhost:6379/0

STORAGE_DIR=./storage/uploads

MAX_UPLOAD_MB=15

# Analysis thresholds — tune without touching code
BLUR_THRESHOLD=100.0
DARK_THRESHOLD=50.0
BRIGHT_THRESHOLD=220.0
DUPLICATE_HASH_DISTANCE=5
